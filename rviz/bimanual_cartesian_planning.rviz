Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Cell Size: 1
    Plane: XY
    Alpha: 0.5
    Color: 160; 160; 164
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Value: /cirtesub/robot_description
    Enabled: true
    Name: RobotModel
    Visual Enabled: true
    Collision Enabled: true
    Value: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Enabled: true
    Name: MotionPlanning
    Planning Group: dual_alpha
    Planning Scene Topic: /cirtesub/moveit/monitored_planning_scene
    Planned Path:
      Loop Animation: true
      Trajectory Topic: /cirtesub/moveit/display_planned_path
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Action paths, poses and constraints
    Topic:
      Value: /cirtesub/manipulation/markers
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world_ned
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.5
      Target Frame: world_ned
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
